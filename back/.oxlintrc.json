{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "options": {
        "typeAware": true
    },
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "no-unused-vars": ["error", { "caughtErrorsIgnorePattern": "^_" }]
    },
    "ignorePatterns": ["dist/**"]
}
