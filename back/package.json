{
    "name": "api.statox.fr",
    "version": "1",
    "description": "The code for my personal API",
    "engines": {
        "node": "24.x"
    },
    "main": "index.ts",
    "type": "module",
    "scripts": {
        "setup-githooks": "./githooks/setup.sh",
        "generate:sdk": "npx tsx scripts/generateSDK.ts ../packages/sdk/src/generated",
        "check": "npm run lint && npm run prettier",
        "dotenvx:getall": "npx dotenvx decrypt --stdout",
        "prettier": "prettier --check --cache '*.json' 'src/**/*.ts' 'tests/**/*.ts'",
        "prettier:fix": "prettier -w --cache '*.json' 'src/**/*.ts' 'tests/**/*.ts'",
        "lint": "eslint",
        "lint:fix": "npm run lint --fix",
        "prod:deploy": "./src/tools/release/deploy.sh",
        "prod:deploy:skip-tests": "./src/tools/release/deploy.sh --skip-tests",
        "postinstall": "tsc",
        "env": "./src/tools/containers-env.sh up",
        "env:stop": "./src/tools/containers-env.sh down",
        "build": "rm -fr dist/ && tsc",
        "serve": "TZ=UTC node --watch dist/index.js",
        "watch": "rm -fr dist/ && tsc -w",
        "tests": "src/tools/init-db.sh --tests && TZ=UTC PORT=3001 ENV=tests mocha --config tests/mocha/routes.json",
        "tests:all": "npm run tests:packages && npm run tests:scripts && npm run tests:framework && npm run tests",
        "tests:ci": "npm run tests:packages -- --reporter mocha-ctrf-json-reporter --reporter-options 'outputFile=packages.json' && npm run tests:framework -- --reporter mocha-ctrf-json-reporter --reporter-options 'outputFile=framework.json' && npm run tests -- --reporter mocha-ctrf-json-reporter --reporter-options 'outputFile=tests.json'",
        "tests:framework": "src/tools/init-db.sh --tests && TZ=UTC PORT=3001 ENV=tests mocha --config tests/mocha/framework.json",
        "tests:scripts": "mocha --config tests/mocha/scripts.json",
        "tests:packages": "mocha --config tests/mocha/packages.json",
        "user:create": "node dist/src/tools/auth/createUser.js",
        "user:create:prod": "npx heroku@latest run node dist/src/tools/auth/createUser.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1066.0",
        "@aws-sdk/s3-request-presigner": "^3.1066.0",
        "@dotenvx/dotenvx": "^1.71.2",
        "@elastic/elasticsearch": "^8.17.1",
        "@slack/webhook": "^7.0.9",
        "@types/passport": "^1.0.17",
        "@types/passport-local": "^1.0.38",
        "@types/ws": "^8.18.1",
        "ajv": "^8.20.0",
        "aws-sdk-client-mock": "^4.1.0",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-json-validator-middleware": "^4.0.0",
        "express-mysql-session": "^3.0.3",
        "express-session": "^1.19.0",
        "jsdom": "^29.1.1",
        "libsodium": "^0.8.4",
        "libsodium-wrappers": "^0.8.4",
        "libsodium-wrappers-sumo": "^0.8.4",
        "lunarphase-js": "^2.0.3",
        "luxon": "^3.7.2",
        "mime-types": "^3.0.2",
        "multer": "^2.1.1",
        "mustache-express": "^1.3.2",
        "mysql2": "^3.22.5",
        "passport": "^0.7.0",
        "passport-local": "^1.0.0",
        "slug": "^11.0.1",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@smithy/util-stream": "^4.6.6",
        "@types/chai": "^5.2.3",
        "@types/connect-sqlite3": "^0.9.6",
        "@types/cookie-signature": "^1.1.2",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-mysql-session": "^3.0.8",
        "@types/express-session": "^1.19.0",
        "@types/jsdom": "^28.0.3",
        "@types/luxon": "^3.7.1",
        "@types/mime-types": "^3.0.1",
        "@types/mocha": "^10.0.10",
        "@types/multer": "^2.1.0",
        "@types/mustache-express": "^1.2.5",
        "@types/nunjucks": "^3.2.6",
        "@types/sinon": "^21.0.1",
        "@types/slug": "^5.0.9",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@typescript-eslint/parser": "^8.32.1",
        "aws-sdk-client-mock-jest": "^4.1.0",
        "chai": "^6.2.2",
        "cookie-signature": "^1.2.2",
        "ctrf": "^0.2.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "github-actions-ctrf": "^0.0.58",
        "globals": "^17.6.0",
        "json-schema-to-ts": "^3.1.1",
        "mocha": "^11.7.6",
        "mocha-ctrf-json-reporter": "^0.0.11",
        "nunjucks": "^3.2.4",
        "prettier": "^3.8.4",
        "sinon": "^22.0.0",
        "supertest": "^7.2.2",
        "typescript": "^6.0.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/statox/api.statox.fr"
    },
    "license": "MIT"
}
