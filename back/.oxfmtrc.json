{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "useTabs": false,
    "tabWidth": 4,
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 100,
    "sortPackageJson": false,
    "ignorePatterns": [
        "node_modules",
        "/build",
        "/.svelte-kit",
        ".env",
        ".env.*",
        "!.env.example",
        "package-lock.json",
        "**/*.md.d.ts"
    ]
}
